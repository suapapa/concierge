# Copy to `.env` in the repo root (same directory as docker-compose.yml).
# Docker Compose loads `.env` for `${…}` substitution when you run:
#   docker compose --profile app up --build
# Do not commit `.env` (secrets).

# Required: PostgreSQL DSN (Compose injects this for the `concierge` service).
CONCIERGE_DATABASE_URL=postgres://concierge:concierge@localhost:5432/concierge?sslmode=disable

# Required for the `concierge` service (profile `app`).
CONCIERGE_GOOGLE_CLIENT_ID=
CONCIERGE_GOOGLE_CLIENT_SECRET=
CONCIERGE_SESSION_SECRET=

# Optional: must match an authorized redirect URI in Google Cloud Console.
# Default in binary: http://localhost:8080/api/v1/auth/google/callback
# CONCIERGE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Optional: comma-separated emails promoted to admin on first login (see README).
# CONCIERGE_BOOTSTRAP_ADMIN_EMAILS=you@example.com

# One-shot: scan CONCIERGE_TMP_DIR for legacy info.yaml, upsert into luggage_objects, remove yaml (then unset).
# CONCIERGE_LUGGAGE_BACKFILL=1

# Luggage expiry sweeps (DB expires_at + disk). Default in binary: sweep every 1m; set 0 to disable in-process sweeps (use CronJob with CONCIERGE_LUGGAGE_EXPIRY_SWEEP_ONCE=1 instead).
# CONCIERGE_LUGGAGE_EXPIRY_SWEEP_INTERVAL=1m
# CONCIERGE_LUGGAGE_EXPIRY_SWEEP_BATCH=500
# One-shot: connect, migrate, sweep until no expired rows, exit (no HTTP; same CONCIERGE_DATABASE_URL and temp dir as the app).
# CONCIERGE_LUGGAGE_EXPIRY_SWEEP_ONCE=1

# Optional: path to Vite build output (default fe/dist). If index.html exists there, GET / serves the React app.
# CONCIERGE_STATIC_UI_DIR=fe/dist
